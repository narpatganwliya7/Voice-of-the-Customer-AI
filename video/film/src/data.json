w": "deliveries", "f": 240}, {"w": "first.", "f": 257}]}, {"id": "improve", "start": 1970, "frames": 233, "words": [{"w": "Fix", "f": 13}, {"w": "the", "f": 23}, {"w": "problems", "f": 26}, {"w": "Écoute", "f": 41}, {"w": "found,", "f": 51}, {"w": "and", "f": 67}, {"w": "E.Leclerc's", "f": 77}, {"w": "recent", "f": 92}, {"w": "rating", "f": 103}, {"w": "could", "f": 117}, {"w": "climb", "f": 122}, {"w": "from", "f": 132}, {"w": "3.4", "f": 137}, {"w": "to", "f": 169}, {"w": "4.2", "f": 172}, {"w": "stars.", "f": 200}]}, {"id": "why", "start": 2203, "frames": 217, "words": [{"w": "Écoute", "f": 13}, {"w": "doesn't", "f": 25}, {"w": "just", "f": 34}, {"w": "count", "f": 41}, {"w": "complaints:", "f": 52}, {"w": "it", "f": 80}, {"w": "prices", "f": 85}, {"w": "them", "f": 100}, {"w": "in", "f": 104}, {"w": "stars,", "f": 107}, {"w": "and", "f": 128}, {"w": "shows", "f": 132}, {"w": "the", "f": 143}, {"w": "evidence", "f": 147}, {"w": "behind", "f": 159}, {"w": "every", "f": 173}, {"w": "finding.", "f": 183}]}, {"id": "site", "start": 2420, "frames": 111, "words": [{"w": "See", "f": 13}, {"w": "it", "f": 20}, {"w": "all", "f": 24}, {"w": "on", "f": 29}, {"w": "the", "f": 32}, {"w": "website:", "f": 34}, {"w": "pick", "f": 59}, {"w": "any", "f": 69}, {"w": "brand.", "f": 78}]}, {"id": "cta", "start": 2531, "frames": 222, "words": [{"w": "Explore", "f": 13}, {"w": "it", "f": 26}, {"w": "yourself.", "f": 28}, {"w": "Écoute.", "f": 63}, {"w": "Every", "f": 91}, {"w": "review,", "f": 101}, {"w": "heard.", "f": 122}]}], "captions": [{"s": 0.3, "e": 1.11, "fr": "Chaque jour,"}, {"s": 0.99, "e": 4.503, "fr": "les clients disent aux marques françaises ce qui ne va pas."}, {"s": 4.383, "e": 6.63, "fr": "La plupart du temps, personne ne lit."}, {"s": 7.2, "e": 10.621, "fr": "Alors j'ai conçu un agent IA qui lit tout."}, {"s": 10.501, "e": 12.35, "fr": "Je l'ai appelé Écoute."}, {"s": 12.933, "e": 16.4, "fr": "Il collecte chaque nouvel avis de 41 marques,"}, {"s": 16.28, "e": 18.333, "fr": "comme BNP Paribas, Orange,"}, {"s": 18.213, "e": 20.043, "fr": "Decathlon et Deliveroo."}, {"s": 20.633, "e": 24.805, "fr": "Un modèle que j'ai entraîné classe chaque avis parmi quinze irritants,"}, {"s": 24.685, "e": 26.483, "fr": "et chiffre chacun en étoiles."}, {"s": 27.067, "e": 29.045, "fr": "Voici ce que nous avons trouvé."}, {"s": 28.925, "e": 31.803, "fr": "Deliveroo affiche 4,4 étoiles sur Google Play,"}, {"s": 31.683, "e": 34.74, "fr": "mais ses avis écrits récents donnent à peine 2,5."}, {"s": 34.62, "e": 38.937, "fr": "Les problèmes de livraison coûtent à eux seuls près d'une demi-étoile."}, {"s": 39.533, "e": 42.428, "fr": "Puis quelque chose casse. Le 10 novembre,"}, {"s": 42.308, "e": 46.014, "fr": "les plaintes sur E.Leclerc sont multipliées par sept."}, {"s": 45.894, "e": 48.586, "fr": "L'agent enquête seul. Il écrit du SQL,"}, {"s": 48.466, "e": 50.886, "fr": "lit les avis, et trouve la cause :"}, {"s": 50.766, "e": 51.969, "fr": "une mise à jour,"}, {"s": 51.849, "e": 54.743, "fr": "avec plantages et connexions impossibles."}, {"s": 56.233, "e": 58.551, "fr": "Puis il rédige sa note. E.Leclerc :"}, {"s": 58.431, "e": 59.869, "fr": "publier un correctif,"}, {"s": 59.749, "e": 62.631, "fr": "et tester la connexion avant chaque version."}, {"s": 62.511, "e": 65.393, "fr": "Deliveroo : corriger d'abord les livraisons."}, {"s": 65.967, "e": 68.79, "fr": "Corrigez les problèmes trouvés par Écoute,"}, {"s": 68.67, "e": 73.167, "fr": "et la note récente d'E.Leclerc pourrait passer de 3,4 à 4,2 étoiles."}, {"s": 73.733, "e": 76.496, "fr": "Écoute ne se contente pas de compter les plaintes :"}, {"s": 76.376, "e": 77.844, "fr": "il les chiffre en étoiles,"}, {"s": 77.724, "e": 80.383, "fr": "et montre les preuves derrière chaque conclusion."}, {"s": 80.967, "e": 84.077, "fr": "Tout est sur le site : choisissez une marque."}, {"s": 84.667, "e": 88.589, "fr": "Explorez-le vous-même. Écoute. Chaque avis,"}, {"s": 88.469, "e": 89.297, "fr": "entendu."